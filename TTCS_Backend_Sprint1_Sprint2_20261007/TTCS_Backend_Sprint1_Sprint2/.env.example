# Run Initialize-Environment.ps1 to create your private .env.
# Values are plain, unquoted; do not put comments after values.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ttcs_handoff
DB_URL=jdbc:postgresql://127.0.0.1:5432/ttcs_handoff
DB_USERNAME=ttcs_handoff
DB_PASSWORD=
AUTH_JWT_SECRET=
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@ttcs.test
BOOTSTRAP_ADMIN_PASSWORD=
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@ttcs.test
RESET_PASSWORD_PAGE_URL=http://localhost:5173/reset-password
ACCOUNT_ACTIVATION_PAGE_URL=http://localhost:5173/activate-account
ACCOUNT_ACTIVATION_TTL=24h
